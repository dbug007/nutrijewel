# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# Wrangler's local state. Holds the LOCAL D1 database (real customer rows if
# anyone ever tests with real details), build bundles and caches. It was once
# swept into git by `git add -A` in deploy.ps1 and published; the content was
# fictional test data and no secret, but it must never be tracked again.
/.wrangler/

# raw source footage (~173MB of camera MP4s). The web versions the site actually
# loads are the compressed files in public/reels/, which are committed.
/video

# The owner's private folder, kept inside the project on purpose: plans, memory,
# originals of resized photos, and LIVE secrets (admin token, Razorpay keys,
# webhook secret). This repo is PUBLIC, so the whole folder is ignored. Keeping
# these files local is the point; one `git add -A` without this line would
# publish every key. Renamed from .claude/ on 2026-09-25.
deepak-instructions/
# Claude Code's own settings (settings.local.json) must live in .claude/, which
# is still ignored for the same reason.
.claude/

# Photos dropped into the app folder to be processed. Phone originals carry
# camera metadata, sometimes GPS, and this repo is public: originals belong in
# deepak-instructions/originals/, web copies in public/images/products/.
# (Only affects new files; images already tracked here stay tracked.)
/*.jpg
/*.jpeg
/*.png
/*.heic
/*.webp

# misc
.DS_Store

# Secrets. This repo is public, so anything matching these must never be
# committed. `.env` itself is ignored deliberately: it used to be tracked, and a
# tracked .env is how a payment key ends up on GitHub. Machine-local settings go
# in .env.local; committed build config that contains no secrets goes in
# .env.production.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.dev.vars
# Key files exported from payment dashboards. Razorpay's "download key" gives a
# CSV named like rzp-key.csv; one was dropped into the repo root once, holding the
# LIVE secret, and would have been published by the next `git add -A`.
rzp-key*.csv
*key*.csv
*secret*
*.pem

npm-debug.log*
yarn-debug.log*
yarn-error.log*
