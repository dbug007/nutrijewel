# Production build settings. Committed on purpose: no secrets belong in this file.
# Secrets live in Cloudflare's encrypted environment variables, never here, and
# never in a REACT_APP_* name, because CRA inlines those into the public bundle.

# Source maps ship the full readable source, including how the API is called.
# Off in production; `npm start` is unaffected.
GENERATE_SOURCEMAP=false
