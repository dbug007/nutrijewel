# Security headers for every response. Cloudflare Pages reads this file from the
# build output. Rules are matched most-specific-first.

/*
  # HTTPS only, for a year, including subdomains. Preload is deliberately left
  # off: getting onto the preload list is easy and getting off it is slow.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Stop browsers guessing a file is a script when we said it is an image.
  X-Content-Type-Options: nosniff
  # Nobody frames this site. Blocks clickjacking of the checkout.
  X-Frame-Options: DENY
  # Send the origin to other sites, never the full path a customer was on.
  Referrer-Policy: strict-origin-when-cross-origin
  # We ask for none of these, so deny them all up front.
  # `payment` is allowed for this site and Razorpay. It used to be `payment=()`,
  # which disables the Payment Request API that Android uses for tap-to-pay UPI
  # (GPay, PhonePe). Found by a real browser test; do not put it back.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), usb=(), interest-cohort=(), payment=(self "https://api.razorpay.com" "https://checkout.razorpay.com")
  # Cross-origin isolation for the payment window, without breaking embeds.
  X-DNS-Prefetch-Control: off

  # Content Security Policy.
  #
  # 'unsafe-inline' on script-src is not decoration and not laziness: index.html
  # carries the GA4 bootstrap, the Organization JSON-LD and the SPA decoder as
  # inline blocks, and CRA gives no nonce mechanism. Removing it means moving
  # those to files first. Flagged in CLAUDE.md as a known compromise.
  #
  # style-src needs 'unsafe-inline' because Framer Motion writes inline styles
  # on every animated element.
  #
  # checkout.razorpay.com and api.razorpay.com are listed now so the policy does
  # not have to change when payments land.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://checkout.razorpay.com https://*.razorpay.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com https://*.razorpay.com; media-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://api.razorpay.com https://lumberjack.razorpay.com https://*.razorpay.com https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://www.google.com https://api.razorpay.com https://checkout.razorpay.com https://*.razorpay.com https://challenges.cloudflare.com; form-action 'self' https://api.razorpay.com https://*.razorpay.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed build assets never change under the same name, so cache them hard.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos change when a product photo is replaced, so keep this shorter.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/reels/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
